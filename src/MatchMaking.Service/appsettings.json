{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BaseUrl": "",
  "Messaging": {
    "Kafka": {
      "Endpoint": "localhost:9092",
      "GroupId": "matchmaking-service-consumer",
      "ConsumerTopic": "matchmaking.complete",
      "ProducerTopic": "matchmaking.request"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379,defaultDatabase=0"
  },
  "Api": {
    "MatchThrottleInMs":  100
  }
}